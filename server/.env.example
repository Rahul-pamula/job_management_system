# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/job_management?retryWrites=true&w=majority

# Groq API Key for LLaMA-3.3 AI features
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Redis connection URL (for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# Express server port
PORT=5000

# Node environment (development | production)
NODE_ENV=development

# Allowed CORS origin (frontend URL)
CLIENT_URL=http://localhost:3000
